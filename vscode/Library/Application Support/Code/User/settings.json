{
  "workbench.colorTheme": "Catppuccin Mocha",
  "catppuccin.accentColor": "mauve",
  "catppuccin.workbenchMode": "minimal",
  "window.titleBarStyle": "custom",
  "window.systemColorTheme": "dark",
  "window.autoDetectColorScheme": false,
  "terminal.integrated.gpuAcceleration": "off",
  "deepseek.lang": "cn",
  "vscode_vibrancy.type": "under-window",
  "vscode_vibrancy.opacity": 0.84,
  "vscode_vibrancy.backgroundOverride": "#1e1e2e",
  "vscode_vibrancy.windowMode": "auto",
  "vscode_vibrancy.theme": "Default Dark",
  "vscode_vibrancy.disableColorCustomizations": true,
  "vscode_vibrancy.preventFlash": true
}
