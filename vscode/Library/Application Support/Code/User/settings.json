  "editor.tokenColorCustomizations": {
    "textMateRules": [
      {
        "scope": [
          "comment",
          "punctuation.definition.comment"
        ],
        "settings": {
          "foreground": "#e0bdcb99",
          "fontStyle": "italic"
        }
      },
      {
        "scope": [
          "variable",
          "variable.language",
          "variable.name",
          "variable.other",
          "variable.parameter"
        ],
        "settings": {
          "foreground": "#feb0d3"
        }
      }
    ]
  },
