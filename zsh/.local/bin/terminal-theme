#!/usr/bin/env python3
"""Select a shared Ghostty, SketchyBar, Borders, calendar, Obsidian and VS Code palette."""

import argparse
import fcntl
import json
import os
from pathlib import Path
import re
import tempfile
import runpy
import subprocess

MARKER = "# Managed by terminal-theme; edit terminal-themes/palettes.json instead."
HEX = re.compile(r"#[0-9a-fA-F]{6}\Z")


def load_palettes(config_dir):
    data = json.loads((config_dir / "terminal-themes/palettes.json").read_text())
    for name, palette in data.items():
        if not re.fullmatch(r"[a-z0-9-]+", name):
            raise ValueError("Invalid theme identifier")
        for key in ("background", "foreground", "cursor", "selection", "selection_text"):
            if not HEX.fullmatch(palette[key]):
                raise ValueError(f"Invalid {key} color in {name}")
        if "desktop_accent" in palette and not HEX.fullmatch(palette["desktop_accent"]):
            raise ValueError(f"Invalid desktop accent in {name}")
        if len(palette["ansi"]) != 16 or not all(HEX.fullmatch(c) for c in palette["ansi"]):
            raise ValueError(f"Theme {name} requires 16 ANSI colors")
    return data


def render(name, palette):
    lines = [MARKER, f"# Theme: {name}",
             f"background = {palette['background']}",
             f"foreground = {palette['foreground']}",
             f"cursor-color = {palette['cursor']}",
             f"cursor-text = {palette['background']}",
             f"selection-background = {palette['selection']}",
             f"selection-foreground = {palette['selection_text']}"]
    lines += [f"palette = {index}={color}" for index, color in enumerate(palette["ansi"])]
    return "\n".join(lines) + "\n"


def managed_target(config_dir):
    # Resolve Stow links before replacing a file so links stay intact.
    return (config_dir / "ghostty/themes/terminal-current").resolve()


def apply_theme(target, content):
    target.parent.mkdir(parents=True, exist_ok=True)
    with (target.parent / ".terminal-theme.lock").open("a") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        if target.exists():
            previous = target.read_text()
            if not previous.startswith(MARKER + "\n"):
                raise ValueError(f"Refusing to overwrite an unmanaged file: {target}")
            if previous == content:
                return
        descriptor, temporary = tempfile.mkstemp(prefix=".terminal-theme-", dir=target.parent)
        try:
            with os.fdopen(descriptor, "w") as handle:
                handle.write(content)
                handle.flush()
                os.fsync(handle.fileno())
            os.chmod(temporary, 0o644)
            os.replace(temporary, target)
        finally:
            if os.path.exists(temporary):
                os.unlink(temporary)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("theme", nargs="?", help="Theme ID shown by --list")
    group = parser.add_mutually_exclusive_group()
    group.add_argument("--list", action="store_true")
    group.add_argument("--current", action="store_true")
    group.add_argument("--preview", action="store_true", help="Print config without changing files")
    group.add_argument("--codex", action="store_true", help="Print a Codex import string without changing apps")
    parser.add_argument("--config-dir", type=Path,
                        default=Path(os.environ.get("XDG_CONFIG_HOME", str(Path.home() / ".config"))))
    parser.add_argument("--no-refresh", action="store_true", help="Generate files without refreshing desktop apps")
    args = parser.parse_args()
    if args.theme and (args.list or args.current):
        parser.error("--list and --current do not accept a theme")
    if args.codex and not args.theme:
        parser.error("--codex requires a theme")
    if args.preview and not args.theme:
        parser.error("--preview requires a theme")
    try:
        palettes = load_palettes(args.config_dir)
        target = managed_target(args.config_dir)
        if args.current:
            match = re.search(r"^# Theme: ([a-z0-9-]+)$", target.read_text(), re.MULTILINE)
            if not match:
                raise ValueError("The active file has no managed theme identifier")
            print(match.group(1))
        elif args.list or not args.theme:
            for name, palette in palettes.items():
                print(f"{name:20} {palette['label']}")
        else:
            if args.theme not in palettes:
                parser.error("Unknown theme; run terminal-theme --list")
            content = render(args.theme, palettes[args.theme])
            if args.codex:
                exporter = runpy.run_path(str(args.config_dir / "terminal-themes/codex.py"))
                print(exporter["render"](args.theme, palettes[args.theme]))
            elif args.preview:
                print(content, end="")
            else:
                desktop = runpy.run_path(str(args.config_dir / "terminal-themes/desktop.py"))
                outputs = desktop["bundle"](args.config_dir, args.theme, palettes[args.theme], palettes, content)
                vscode = runpy.run_path(str(args.config_dir / "terminal-themes/vscode.py"))
                settings = vscode["prepare"](args.config_dir, args.theme)
                desktop["apply_bundle"](args.config_dir, outputs, settings)
                print(f"Selected: {palettes[args.theme]['label']}")
                if settings:
                    print("VS Code: color theme shared across all Profiles.")
                if not args.no_refresh:
                    desktop["refresh_desktop"](args.config_dir)
                print("Ghostty: press Command+Shift+, to reload colors. Existing shells keep their processes.")
    except (OSError, ValueError, KeyError, TypeError, subprocess.TimeoutExpired) as error:
        parser.exit(1, f"terminal-theme: {error}\n")


if __name__ == "__main__":
    main()
